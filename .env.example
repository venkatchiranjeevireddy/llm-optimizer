## API key for Groq (https://console.groq.com/keys).
## Copy this file to `.env` and paste your real key — never commit `.env`.
GROQ_API_KEY=""

## API key for Google AI Studio / Gemini (optional for this codebase).
GEMINI_API_KEY=""

## Async SQLAlchemy/PostgreSQL connection string.
POSTGRES_URL="postgresql+asyncpg://llm_user:password@localhost:5432/llmoptimizer"
REDIS_URL="redis://localhost:6379"

## Filesystem path to trained router model pickle.
ROUTER_MODEL_PATH="models/router_model.pkl"

## Filesystem path to router feature names JSON.
FEATURE_NAMES_PATH="models/feature_names.json"

## Filesystem path to router label mapping JSON.
LABEL_MAP_PATH="models/label_map.json"

## Filesystem path prefix for FAISS index files.
FAISS_INDEX_PATH="models/faiss_index"

## Cosine similarity threshold for cache hit reuse.
CACHE_SIMILARITY_THRESHOLD=0.85

## Cache entry lifetime in seconds.
CACHE_TTL_SECONDS=86400

## Minimum router confidence before trusting route decision.
ROUTER_CONFIDENCE_THRESHOLD=0.60

## Maximum daily spend limit in USD.
DAILY_BUDGET_USD=5.00

## Number of queries between router retraining cycles.
RETRAIN_EVERY_N_QUERIES=500

## Maximum tolerated bad response rate before safeguards trigger.
BAD_RESPONSE_RATE_THRESHOLD=0.20

## Default cap for output token generation.
MAX_TOKENS=1000

## Logging verbosity level (e.g., DEBUG, INFO, WARNING).
LOG_LEVEL="INFO"

## Cost per 1k tokens for Groq Llama 3.
GROQ_LLAMA3_COST=0.00005

## Cost per 1k tokens for Groq Mixtral.
GROQ_MIXTRAL_COST=0.00027

## Cost per 1k tokens for Gemini Pro.
GEMINI_PRO_COST=0.00350

